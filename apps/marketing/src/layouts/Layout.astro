---
import { GITHUB_REPOSITORY_URL } from "../lib/site";
interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}
const {
  title = "Solla Code — Make room for the work.",
  description = "Your agents. Your tools. One workspace. Solla Code brings coding conversations, terminals, previews, and artifacts together.",
  pageClass,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080808" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/brand/solla-bolt.svg" />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={["page", pageClass]}>
      <header class="nav">
        <nav class="nav-inner" aria-label="Main navigation">
          <a href="/" class="nav-brand" aria-label="Solla Code home"
            ><img
              src="/brand/solla-bolt.svg"
              width="25"
              height="30"
              alt=""
            /><span>Solla Code</span></a
          >
          <div class="nav-links">
            <a href="/#workspace">Explore</a><a href="/pricing">Pricing</a><a
              href="/guide">Get started</a>
          </div>
          <a class="nav-download" href="/download"
            >Download <span aria-hidden="true">↓</span></a
          >
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="footer">
        <div class="footer-top">
          <a class="nav-brand" href="/"
            ><img
              src="/brand/solla-bolt.svg"
              alt=""
              width="28"
              height="34"
            />Solla Code</a
          ><p>Make room for the work.</p>
        </div>
        <div class="footer-grid">
          <div>
            <h2>Product</h2><a href="/#workspace">The workspace</a><a
              href="/pricing">Pricing</a
            ><a href="/download">Download</a><a href="/guide">Get started</a>
          </div>
          <div>
            <h2>Developers</h2><a href={GITHUB_REPOSITORY_URL}
              >Source on GitHub ↗</a
            ><a href={`${GITHUB_REPOSITORY_URL}/tree/main/docs`}
              >Documentation ↗</a
            ><a href={`${GITHUB_REPOSITORY_URL}/releases`}>Release notes ↗</a
            ><a href={`${GITHUB_REPOSITORY_URL}/issues`}>Report an issue ↗</a>
          </div>
          <div>
            <h2>Details</h2><a href="/terms-of-service">Terms</a><a
              href="/privacy-policy">Privacy</a
            ><a href="/security-policy">Security</a><a href="/legal"
              >Licenses &amp; attribution</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>
            Independently maintained. An MIT-licensed fork of <a
              href="https://github.com/pingdotgg/t3code">T3 Code</a
            >.
          </p><p>© 2026 Solla Code contributors.</p>
        </div>
      </footer>
    </div>
  </body>
</html>
<style is:global>
  @font-face {
    font-family: "DM Sans";
    src: url("/fonts/dm-sans-latin.woff2") format("woff2");
    font-style: normal;
    font-weight: 100 1000;
    font-display: swap;
  }
  :root {
    --bg: #080808;
    --bg-elev: #101010;
    --bg-card: #151515;
    --fg: #f4f2ed;
    --fg-muted: #aaa8a2;
    --fg-dim: #8b8983;
    --fg-faint: #74716b;
    --border: #292824;
    --border-strong: #454139;
    --accent: #e9bc65;
    --accent-dim: #e9bc6518;
    --ok: #98c49c;
    --warn: #e9bc65;
    --font-sans:
      "DM Sans", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
    --radius: 16px;
    --radius-sm: 8px;
    --radius-lg: 28px;
  }
  * {
    box-sizing: border-box;
  }
  html {
    color-scheme: dark;
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }
  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  button {
    font: inherit;
    color: inherit;
  }
  img,
  video {
    display: block;
    max-width: 100%;
    height: auto;
  }
  button,
  a,
  input,
  summary {
    touch-action: manipulation;
  }
  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  ::selection {
    background: #e9bc6540;
  }
  main:focus {
    outline: none;
  }
  .skip-link {
    position: fixed;
    top: -100px;
    left: 20px;
    z-index: 100;
    padding: 12px 20px;
    background: var(--accent);
    color: #17130b;
  }
  .skip-link:focus {
    top: 12px;
  }
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #080808e8;
    border-bottom: 1px solid #ffffff0d;
    backdrop-filter: blur(20px);
  }
  .nav-inner {
    max-width: 1200px;
    padding: 0 32px;
    margin: auto;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.5px;
    white-space: nowrap;
  }
  .nav-brand img {
    object-fit: contain;
  }
  .nav-links {
    display: flex;
    gap: 32px;
    font-size: 12px;
    color: #c5c3be;
  }
  .nav-links a:hover,
  .footer a:hover {
    color: var(--accent);
  }
  .nav-download {
    padding: 7px 16px;
    border-radius: 30px;
    background: var(--accent);
    color: #21190d;
    font-size: 12px;
    font-weight: 650;
  }
  .nav-download span {
    margin-left: 10px;
  }
  .section {
    max-width: 1200px;
    margin: auto;
    padding: 120px 32px;
  }
  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.02em;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 22px;
  }
  .section-title {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.06;
    letter-spacing: -0.045em;
    font-weight: 600;
    max-width: 800px;
  }
  .muted {
    color: var(--fg-muted);
  }
  .lead {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--fg-muted);
    max-width: 590px;
    margin-top: 28px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid transparent;
    border-radius: 28px;
    background: var(--accent);
    color: #241a09;
    font-size: 15px;
    font-weight: 600;
    transition:
      background 0.18s,
      transform 0.18s;
  }
  .button:hover {
    background: #f5d28f;
    transform: translateY(-1px);
  }
  .button.secondary {
    background: transparent;
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .button.secondary:hover {
    background: #ffffff0b;
  }
  .text-link {
    color: var(--accent);
    font-size: 16px;
  }
  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .actions {
    display: flex;
    gap: 22px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 34px;
  }
  .fine-print {
    font-size: 13px;
    color: var(--fg-dim);
    line-height: 1.6;
  }
  .hairline {
    border-top: 1px solid var(--border);
  }
  .footer {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px 32px 28px;
    border-top: 1px solid var(--border);
  }
  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .footer-top p {
    color: var(--fg-muted);
    font-size: 16px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
    margin: 55px 0;
  }
  .footer-grid h2 {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  .footer-grid a {
    display: block;
    width: fit-content;
    font-size: 13px;
    color: var(--fg-muted);
    margin: 12px 0;
  }
  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-size: 11px;
    color: var(--fg-dim);
  }
  .footer-bottom a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 640px) {
    .nav-inner {
      height: 60px;
      padding: 0 20px;
      gap: 16px;
    }
    .nav-brand {
      font-size: 15px;
    }
    .nav-links {
      gap: 18px;
    }
    .nav-links a:first-child {
      display: none;
    }
    .nav-links a:last-child {
      display: none;
    }
    .nav-download {
      padding: 7px 13px;
    }
    .section {
      padding: 80px 24px;
    }
    .footer {
      padding: 50px 24px 24px;
    }
    .footer-top {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
    .footer-grid {
      gap: 22px;
      grid-template-columns: 1fr 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
    }
    .actions {
      gap: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
