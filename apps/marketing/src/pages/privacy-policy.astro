---
import LegalPage from "../components/LegalPage.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
---

<LegalPage
  title="Data and connected services — Solla Code"
  description="Where to learn about data handling in Solla Code."
  heading="Data and connected services"
  lede="Where to learn about data handling in Solla Code."
  lastUpdated="2026-09-04"
  sections={[
    ["environment", "Your environment"],
    ["services", "Connected services"],
    ["scope", "Scope of this notice"],
  ]}
>
  <section id="environment">
    <p class="section-number">01</p>
    <h2>Your environment</h2>
    <p>
      Solla Code connects clients to an environment on a host machine. That
      environment stores conversations, settings, attachments, and provider
      state. See the <a
        href={`${GITHUB_REPOSITORY_URL}/blob/main/docs/user/storage.md`}
        >storage guide</a
      > and <a
        href={`${GITHUB_REPOSITORY_URL}/blob/main/docs/user/remote-access.md`}
        >remote access guide</a
      > for the current implementation.
    </p>
  </section>
  <section id="services">
    <p class="section-number">02</p>
    <h2>Connected services</h2>
    <p>
      Prompts and other task inputs can be sent to the providers and tools you
      configure. Provider services, source-control hosts, and any operator
      hosting an environment for you have their own data practices. This
      marketing site serves its fonts locally and retrieves release information
      from GitHub.
    </p>
  </section>
  <section id="scope">
    <p class="section-number">03</p>
    <h2>Scope of this notice</h2>
    <p>
      This is a description of the open-source project, not the privacy policy
      of T3 Tools or an assertion about a particular hosted deployment. Solla
      Code is an independent fork; upstream privacy contacts and policies do not
      represent its operator.
    </p>
  </section>
</LegalPage>
