---
import Layout from "../layouts/Layout.astro";
import BrandBolt from "../components/BrandBolt.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
const chapters = [
  {
    name: "One workspace",
    image: "/media/workspace.png",
    alt: "Solla Code workspace with project threads, agent conversation, and connected tools",
    title: "Everything the work needs. Right here.",
    text: "Keep the conversation beside your terminal, your preview, and the files taking shape. Less looking for context. More building on it.",
  },
  {
    name: "Built-in terminals",
    image: "/media/terminals.png",
    alt: "Two terminal panes in a Solla Code thread, showing source code and five passing tests",
    title: "Stay close to the code.",
    text: "Run commands, inspect output, and work in split terminals without leaving the thread. Your tools stay part of the conversation.",
  },
  {
    name: "Living artifacts",
    image: "/media/artifacts.png",
    alt: "The Lumen dashboard artifact alongside its originating Solla Code thread",
    title: "Give the result a place to live.",
    text: "Open the artifact beside the conversation that created it. Revisit revisions and keep the result connected to the decisions behind it.",
  },
];
---

<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Solla Code</p><h1 id="hero-title">
        Make room<br />for the <span>work.</span>
      </h1><p class="hero-description">
        Your agents. Your tools.<br />Finally, one workspace.
      </p><div class="actions">
        <a href="/download" class="button"
          >Get Solla Code <span aria-hidden="true">↓</span></a
        ><a href="#film" class="text-link"
          >Watch the film <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-object">
      <div class="object-light" aria-hidden="true"></div><BrandBolt />
    </div>
    <div class="hero-footnote">
      <span>Built for the way you build.</span><span
        >macOS · Windows · Linux</span>
    </div>
  </section>

  <section
    class="workspace section"
    id="workspace"
    aria-labelledby="workspace-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">The workspace</p><h2
          class="section-title"
          id="workspace-title"
        >
          A clear view.<br /><span class="muted">Of everything in motion.</span>
        </h2>
      </div><p class="section-aside">
        From the first prompt to the final review, keep your agents and their
        work in the same place.
      </p>
    </div>
    <div class="chapter-tabs" role="tablist" aria-label="Explore the workspace">
      {
        chapters.map((chapter, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${index}`}
            aria-controls={`chapter-${index}`}
            aria-selected={index === 0}
            tabindex={index === 0 ? 0 : -1}
          >
            {chapter.name}
          </button>
        ))
      }
    </div>
    {
      chapters.map((chapter, index) => (
        <div
          class="chapter"
          id={`chapter-${index}`}
          role="tabpanel"
          aria-labelledby={`tab-${index}`}
          hidden={index !== 0}
        >
          <>
            <div class="product-frame">
              <img
                src={chapter.image}
                alt={chapter.alt}
                width="1314"
                height="912"
                loading="lazy"
              />
            </div>
            <div class="chapter-caption">
              <>
                <h3>{chapter.title}</h3>
                <p>{chapter.text}</p>
              </>
            </div>
          </>
        </div>
      ))
    }
  </section>

  <section class="provider-section hairline">
    <div class="section">
      <p class="eyebrow">Choose your intelligence</p><h2 class="section-title">
        Great work takes<br /><span class="muted"
          >more than one point of view.</span>
      </h2><div class="provider-grid">
        <p class="lead">
          Work with the coding providers you already use. Keep your projects and
          conversations together as your tools evolve.
        </p><div class="provider-names" aria-label="Supported coding providers">
          <span>Codex</span><span>Claude</span><span>Cursor</span><span
            >OpenCode</span
          ><span>Grok</span><span>Antigravity</span>
        </div>
      </div><p class="fine-print provider-note">
        Connect your own provider accounts. Model access, usage limits, costs,
        and available tools depend on your provider.
      </p>
    </div>
  </section>

  <section class="section craft">
    <div class="craft-heading">
      <p class="eyebrow">Your working rhythm</p><h2 class="section-title">
        Less managing.<br /><span class="muted">More making.</span>
      </h2>
    </div><div class="feature-grid">
      <article>
        <div class="feature-visual voice-visual" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span
          ></span><span></span><span></span><span></span>
        </div><p class="feature-number">01 / SPEAK</p><h3>
          Start with a thought.
        </h3><p>
          Talk to the orchestrator when typing would slow you down. Turn a
          spoken idea into the next piece of work.
        </p>
      </article><article>
        <div class="feature-visual agents-visual" aria-hidden="true">
          <div><i></i><span>Design Engineer</span><b>Working</b></div><div>
            <i></i><span>Code Reviewer</span><b>Ready</b>
          </div><div><i></i><span>Release Manager</span><b>Ready</b></div>
        </div><p class="feature-number">02 / DELEGATE</p><h3>
          A team shaped by you.
        </h3><p>
          Create agents with a purpose, tools, and working instructions. Give
          recurring work a consistent place to happen.
        </p>
      </article><article>
        <div class="feature-visual remote-visual" aria-hidden="true">
          <div class="computer">Your Mac</div><div class="connection-line">
          </div><div class="computer">Your PC</div><span
            >Connected workspace</span>
        </div><p class="feature-number">03 / CONNECT</p><h3>
          The work travels with you.
        </h3><p>
          Connect to another environment and reach the projects on that machine.
          Keep your workspace close, wherever it runs.
        </p>
      </article>
    </div>
  </section>

  <section class="film-section" id="film">
    <div class="section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Solla Code, in motion</p><h2 class="section-title">
            From a thought.<br />To something real.
          </h2>
        </div><p class="section-aside">
          Take a closer look at a day in the workspace.
        </p>
      </div><video
        controls
        preload="none"
        playsinline
        poster="/media/solla-code-film-poster.png"
        width="1920"
        height="1080"
        aria-label="Solla Code product film"
        ><source src="/media/solla-code-film.mp4" type="video/mp4" /><track
          kind="captions"
          src="/media/solla-code-film.vtt"
          srclang="en"
          label="English"
        />Your browser does not support this video. <a
          href="/media/solla-code-film.mp4">Download the film</a
        >.</video
      ><p class="fine-print">
        Product demonstration with illustrative project content. Original
        visuals and soundtrack.
      </p>
    </div>
  </section>

  <section class="section open-section">
    <div>
      <p class="eyebrow">Open at its core</p><h2 class="section-title">
        Your workspace.<br /><span class="muted">In plain sight.</span>
      </h2>
    </div><div>
      <p class="lead">
        Solla Code is independently maintained and built on open source. Read
        the code. Follow the changes. Make it your own.
      </p><a class="text-link" href={GITHUB_REPOSITORY_URL}
        >Explore the source <span aria-hidden="true">↗</span></a
      ><p class="fine-print">
        A fork of T3 Code, distributed under the MIT license.
      </p>
    </div>
  </section>
  <section class="closing">
    <img
      src="/brand/solla-bolt.svg"
      width="72"
      height="88"
      alt=""
      loading="lazy"
    /><h2>A little more focus.<br />A lot more possibility.</h2><p>
      $10 per month. Or $120 per year.
    </p><a class="button" href="/pricing"
      >Explore pricing <span aria-hidden="true">→</span></a>
  </section>
</Layout>
<script>
  const tabs = [
    ...document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  ];
  function selectTab(index: number) {
    tabs.forEach((tab, i) => {
      const selected = i === index;
      tab.setAttribute("aria-selected", String(selected));
      tab.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(
        tab.getAttribute("aria-controls") ?? "",
      );
      if (panel) panel.hidden = !selected;
    });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(index));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft")
        next = (index + tabs.length - 1) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectTab(next);
      tabs[next]?.focus();
    });
  });
</script>
<style>
  .hero {
    max-width: 1440px;
    position: relative;
    margin: auto;
    min-height: 790px;
    padding: 150px max(32px, calc((100% - 1136px) / 2)) 90px;
    isolation: isolate;
    overflow: hidden;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }
  .hero .eyebrow {
    font-size: 17px;
    color: var(--fg);
    margin-bottom: 30px;
  }
  .hero h1 {
    font-size: clamp(64px, 7.2vw, 108px);
    letter-spacing: -0.065em;
    line-height: 0.99;
    font-weight: 600;
  }
  .hero h1 span {
    color: var(--accent);
  }
  .hero-description {
    font-size: 24px;
    line-height: 1.35;
    letter-spacing: -0.03em;
    color: var(--fg-muted);
    margin-top: 30px;
  }
  .hero-object {
    position: absolute;
    width: 700px;
    height: 700px;
    right: -40px;
    top: 34px;
    z-index: 1;
    transform: rotate(-8deg);
  }
  .hero-object img {
    position: relative;
    filter: drop-shadow(0 40px 65px #000);
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .object-light {
    position: absolute;
    inset: 12%;
    background: radial-gradient(ellipse, #c8953320, transparent 65%);
    filter: blur(30px);
  }
  .hero-footnote {
    position: absolute;
    bottom: 35px;
    left: max(32px, calc((100% - 1136px) / 2));
    right: max(32px, calc((100% - 1136px) / 2));
    display: flex;
    justify-content: space-between;
    color: var(--fg-dim);
    font-size: 12px;
    border-top: 1px solid var(--border);
    padding-top: 22px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    align-items: flex-end;
    margin-bottom: 50px;
  }
  .section-aside {
    color: var(--fg-muted);
    max-width: 285px;
    font-size: 18px;
    line-height: 1.5;
    padding-bottom: 5px;
  }
  .workspace {
    padding-top: 100px;
  }
  .chapter-tabs {
    display: flex;
    gap: 6px;
    border: 1px solid var(--border);
    padding: 5px;
    border-radius: 30px;
    width: fit-content;
    margin: 0 0 36px;
    background: #101010;
  }
  .chapter-tabs button {
    border: 0;
    border-radius: 24px;
    background: transparent;
    padding: 10px 20px;
    font-size: 13px;
    cursor: pointer;
    color: var(--fg-muted);
  }
  .chapter-tabs button[aria-selected="true"] {
    background: #333027;
    color: #f7deb1;
  }
  .product-frame {
    border: 1px solid #4e463933;
    background: linear-gradient(135deg, #28231b, #101010 45%);
    border-radius: 22px;
    padding: 20px;
    overflow: hidden;
  }
  .product-frame img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 20px 50px #0008;
  }
  .chapter-caption {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    margin-top: 32px;
  }
  .chapter-caption h3 {
    font-size: 24px;
    font-weight: 550;
    letter-spacing: -0.03em;
  }
  .chapter-caption p {
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.55;
  }
  .provider-section {
    background: #101010;
  }
  .provider-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
    margin-top: 30px;
  }
  .provider-names {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 38px;
    font-size: 24px;
    letter-spacing: -0.04em;
    font-weight: 550;
  }
  .provider-note {
    margin-top: 42px;
    max-width: 480px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 55px;
  }
  .feature-grid article {
    background: var(--bg-card);
    border-radius: 24px;
    padding: 30px 26px 36px;
    overflow: hidden;
  }
  .feature-grid h3 {
    font-size: 25px;
    line-height: 1.2;
    letter-spacing: -0.035em;
    font-weight: 550;
    margin: 18px 0;
  }
  .feature-grid article > p:last-child {
    font-size: 16px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .feature-number {
    color: var(--fg-dim);
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .feature-visual {
    height: 165px;
    margin: 0 -4px 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .voice-visual {
    gap: 8px;
  }
  .voice-visual span {
    height: 26px;
    width: 6px;
    border-radius: 10px;
    background: linear-gradient(#f6d69c, #946a28);
  }
  .voice-visual span:nth-child(2n) {
    height: 55px;
  }
  .voice-visual span:nth-child(3n) {
    height: 90px;
  }
  .voice-visual span:nth-child(5) {
    height: 125px;
  }
  .agents-visual {
    flex-direction: column;
    gap: 9px;
  }
  .agents-visual div {
    display: flex;
    width: 100%;
    padding: 12px 10px;
    border: 1px solid var(--border);
    background: #111;
    border-radius: 8px;
    align-items: center;
    gap: 8px;
    font-size: 11px;
  }
  .agents-visual i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #a99061;
  }
  .agents-visual b {
    margin-left: auto;
    font-size: 9px;
    font-weight: 400;
    color: var(--fg-dim);
  }
  .agents-visual div:first-child {
    border-color: #645132;
  }
  .agents-visual div:first-child b {
    color: var(--accent);
  }
  .remote-visual {
    position: relative;
    gap: 0;
    padding-bottom: 20px;
  }
  .computer {
    padding: 25px 11px;
    border: 1px solid #635134;
    border-radius: 8px;
    background: linear-gradient(145deg, #33291b, #171513);
    font-size: 12px;
    white-space: nowrap;
  }
  .connection-line {
    height: 1px;
    width: 44px;
    background: var(--accent);
  }
  .remote-visual > span {
    position: absolute;
    bottom: 8px;
    font-size: 10px;
    color: var(--fg-dim);
  }
  .film-section {
    background: #111;
  }
  .film-section video {
    border-radius: 20px;
    background: #080808;
    width: 100%;
    border: 1px solid var(--border);
  }
  .film-section .fine-print {
    margin-top: 20px;
  }
  .open-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .open-section .lead {
    margin-top: 35px;
  }
  .open-section .text-link {
    display: inline-block;
    margin: 28px 0 18px;
  }
  .closing {
    padding: 90px 24px 140px;
    text-align: center;
  }
  .closing img {
    margin: 0 auto 30px;
  }
  .closing h2 {
    font-size: clamp(38px, 5.5vw, 68px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.05em;
  }
  .closing p {
    margin: 28px 0;
    color: var(--fg-muted);
    font-size: 20px;
  }
  @media (min-width: 1440px) {
    .hero {
      padding-left: 152px;
      padding-right: 152px;
    }
    .hero-footnote {
      left: 152px;
      right: 152px;
    }
    .hero-object {
      right: 20px;
    }
  }
  @media (max-width: 1000px) {
    .hero {
      min-height: 700px;
      padding-top: 110px;
    }
    .hero-object {
      width: 530px;
      height: 600px;
      right: -110px;
      top: 40px;
      opacity: 0.8;
    }
    .hero-copy {
      max-width: 550px;
    }
    .hero h1 {
      font-size: 80px;
    }
    .provider-grid {
      gap: 50px;
    }
    .feature-grid {
      gap: 14px;
    }
    .feature-grid article {
      padding: 22px 20px 30px;
    }
    .feature-grid h3 {
      font-size: 23px;
    }
  }
  @media (max-width: 700px) {
    .hero {
      padding: 65px 24px 400px;
      min-height: 950px;
    }
    .hero .eyebrow {
      margin-bottom: 24px;
    }
    .hero h1 {
      font-size: 72px;
      max-width: 440px;
    }
    .hero-description {
      font-size: 21px;
    }
    .hero-object {
      width: 440px;
      height: 440px;
      right: calc(50% - 230px);
      top: auto;
      bottom: 55px;
      opacity: 1;
      transform: rotate(-12deg);
    }
    .hero-footnote {
      left: 24px;
      right: 24px;
      bottom: 24px;
      font-size: 10px;
    }
    .section-heading {
      display: block;
    }
    .section-aside {
      margin-top: 24px;
      max-width: 450px;
      font-size: 17px;
    }
    .chapter-tabs {
      max-width: 100%;
      gap: 2px;
      padding: 4px;
    }
    .chapter-tabs button {
      padding: 10px 12px;
      font-size: 11px;
    }
    .product-frame {
      padding: 8px;
      border-radius: 14px;
      margin: 0 -12px;
    }
    .product-frame img {
      border-radius: 8px;
    }
    .chapter-caption {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 26px;
    }
    .chapter-caption h3 {
      font-size: 22px;
    }
    .chapter-caption p {
      font-size: 16px;
    }
    .provider-grid {
      grid-template-columns: 1fr;
      gap: 38px;
      margin-top: 10px;
    }
    .provider-names {
      font-size: 24px;
      gap: 22px;
    }
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-top: 38px;
    }
    .feature-grid article {
      padding: 30px;
    }
    .feature-visual {
      max-width: 320px;
      margin: 0 auto 28px;
    }
    .feature-grid h3 {
      font-size: 29px;
    }
    .open-section {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .open-section .lead {
      margin-top: 24px;
    }
    .closing {
      padding: 50px 24px 100px;
    }
    .closing p {
      font-size: 17px;
    }
    .film-section video {
      border-radius: 12px;
    }
  }
</style>
