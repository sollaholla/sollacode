---
import LegalPage from "../components/LegalPage.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
---

<LegalPage
  title="Security information — Solla Code"
  description="Security boundaries and reporting information for the Solla Code fork."
  heading="Security information"
  lede="Security boundaries and reporting information for the Solla Code fork."
  lastUpdated="2026-09-04"
  sections={[
    ["reporting", "Reporting issues"],
    ["host", "Host and provider access"],
    ["scope", "Project scope"],
  ]}
>
  <section id="reporting">
    <p class="section-number">01</p>
    <h2>Reporting issues</h2>
    <p>
      Use the <a href={`${GITHUB_REPOSITORY_URL}/security`}
        >repository security page</a
      > to check the reporting options enabled by this fork's maintainers. Do not
      include credentials, private conversation data, or exploitable details in public
      issues. Upstream T3 Tools contact addresses are not Solla Code reporting channels.
    </p>
  </section>
  <section id="host">
    <p class="section-number">02</p>
    <h2>Host and provider access</h2>
    <p>
      Run providers and tools only on hosts and workspaces you trust. An agent
      can read or modify the resources granted by its runtime and tool
      permissions. Pair only with environments you intend to access, and review
      the <a
        href={`${GITHUB_REPOSITORY_URL}/blob/main/docs/user/remote-access.md`}
        >remote access documentation</a
      > before exposing a server.
    </p>
  </section>
  <section id="scope">
    <p class="section-number">03</p>
    <h2>Project scope</h2>
    <p>
      Solla Code is an independent open-source fork of T3 Code. This page does
      not promise a vulnerability bounty, a response deadline, or security
      operations for upstream infrastructure.
    </p>
  </section>
</LegalPage>
